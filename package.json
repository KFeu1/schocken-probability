{
  "name": "schocken",
  "version": "1.0.4",
  "description": "Calculates probabilities for the German dice game \"Schocken\", not using \"Jule\", but using the strategy \"Schocken heißt das Spiel\".",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "check": "tsc && tsc -p tsconfig.build.json --noEmit",
    "run": "node run.ts",
    "simulate": "node simulate.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "type": "module",
  "keywords": [
    "schocken",
    "dice",
    "probability",
    "german",
    "game"
  ],
  "author": {
    "name": "Konstantin Feuerborn",
    "email": "k.feuerborn@yahoo.de"
  },
  "license": "MIT",
  "dependencies": {
    "precise-fractions": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "decimal.js": "^10.5.0",
    "progress": "^2.0.3",
    "typescript": "^5.7.3",
    "yargs-parser": "^21.1.1",
    "zod": "^3.24.2"
  }
}
